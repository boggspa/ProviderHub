*.app/
*.zip
.DS_Store
.venv/
Source/.build/
.build/
dist/
.pytest_cache/
.uv-cache/
__pycache__/
*.pyc
work/

# Credentials. python-dotenv is an optional dependency and bridge_core.py will
# read a .env when one is present, so make sure one can never be staged.
.env
.env.*
!.env.example

# Concurrent-work markers and sidecar state (AGENTS.md)
.WORK-IN-PROGRESS-*.md
SHIP-HOLD-*.md
SESSION-IN-PROGRESS-*.md
.work-guard/

# Per-session scratch — see AGENTS.md "Scratch goes in .local-only/".
# The directory is tracked via its README so a fresh clone has it;
# everything else inside is ignored.
.local-only/*
!.local-only/README.md
